{
  "name": "dsh-local-browser-access",
  "version": "0.1.0",
  "description": "为 DSH 插件开发打通内置浏览器访问链路，让配套自动化插件直接操控并检查页面。",
  "icon": "./assets/logo.png",
  "author": "qingtiannew",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qingtiannew/dsh-local-browser-access.git"
  },
  "homepage": "https://github.com/qingtiannew/dsh-local-browser-access#readme",
  "bugs": {
    "url": "https://github.com/qingtiannew/dsh-local-browser-access/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "local-browser",
    "token-free",
    "browser-access"
  ],
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.5"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  }
}
